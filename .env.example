# Copy to .env for local development. In Vercel, set these under Project → Settings → Environment Variables.

# Supabase Postgres (Connect → Transaction pooler, port 6543). Leave empty locally to use the embedded database.
DATABASE_URL=

# Long random string used to sign sessions (required in production)
JWT_SECRET=

# Master admin, created on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Public URL of the app (used in email links), e.g. https://mbg-daily-report.vercel.app
APP_URL=

# Gmail sending: the Gmail address and a Google "App password" (not the normal password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Drive (OAuth client from Google Cloud + refresh token from: node scripts/google-auth.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER=MBG-Daily Report

TZ=America/Los_Angeles
